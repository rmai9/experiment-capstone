# Environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / JavaScript
node_modules/
dist/
build/
.next/
*.log

# Databases
*.sqlite3
*.db

# OS / IDE
.DS_Store
.idea/
.vscode/

# Gradio runtime/cache files
.gradio/

# Private inspection data — never commit
data/raw_videos/*
!data/raw_videos/.gitkeep

data/raw_frames/*
!data/raw_frames/.gitkeep

data/processed_frames/*
!data/processed_frames/.gitkeep

data/annotations/*
!data/annotations/.gitkeep

data/datasets/*
!data/datasets/.gitkeep

data/manifests/*
!data/manifests/.gitkeep

data/reports/*
!data/reports/.gitkeep

# Model artifacts and derived private outputs
artifacts/*
!artifacts/.gitkeep

# Common ML experiment outputs
runs/
wandb/
mlruns/
lightning_logs/
tensorboard/

# Generated extractor output
data/frames/*
artifacts/manifests/*

# Preserve empty directories after clone
!data/frames/.gitkeep
!artifacts/manifests/.gitkeep